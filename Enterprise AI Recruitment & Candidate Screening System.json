td><strong>Skills Score</strong></td>\n<td>{{ $json[\"Skills Score\"] }}/100</td>\n</tr>\n\n<tr>\n<td><strong>Education Score</strong></td>\n<td>{{ $json[\"Education Score\"] }}/100</td>\n</tr>\n\n<tr style=\"background:#f9fafb;\">\n<td><strong>Communication Score</strong></td>\n<td>{{ $json[\"Communication Score\"] }}/100</td>\n</tr>\n\n<tr>\n<td><strong>Recommendation</strong></td>\n<td style=\"font-weight:bold;color:#dc2626;\">\n{{ $json[\"Recommendation\"] }}\n</td>\n</tr>\n\n<tr style=\"background:#f9fafb;\">\n<td><strong>AI Assessment</strong></td>\n<td>{{ $json[\"Reason\"] }}</td>\n</tr>\n\n</table>\n\n<div style=\"margin-top:35px;padding:20px;background:#eef6ff;border-left:5px solid #2563eb;border-radius:6px;\">\n\n<h3 style=\"margin-top:0;color:#1d4ed8;\">\nWe Encourage You to Apply Again\n</h3>\n\n<p style=\"color:#444;line-height:1.8;margin-bottom:0;\">\nAlthough you were not selected for this opportunity, we sincerely encourage you to continue developing your skills and apply again for future positions that match your experience and qualifications.\n</p>\n\n</div>\n\n<p style=\"margin-top:35px;color:#555;line-height:1.8;\">\nThank you once again for your interest in joining our organization. We wish you every success in your future career.\n</p>\n\n<p style=\"margin-top:35px;\">\nKind Regards,<br>\n<strong>AI Recruitment Team</strong>\n</p>\n\n</td>\n</tr>\n\n<tr>\n<td style=\"background:#1f2937;color:white;text-align:center;padding:18px;font-size:13px;\">\n© 2026 AI Recruitment System | Automated Candidate Screening\n</td>\n</tr>\n\n</table>\n\n</td>\n</tr>\n</table>\n\n</body>\n</html>",
