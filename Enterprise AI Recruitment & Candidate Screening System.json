        "sendTo": "faiziyakhanwork@gmail.com",
        "subject": "Application Status - Under Review",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<title>Application Under Review</title>\n</head>\n\n<body style=\"margin:0;padding:0;background:#f4f6f9;font-family:Arial,Helvetica,sans-serif;\">\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:40px 0;background:#f4f6f9;\">\n<tr>\n<td align=\"center\">\n\n<table width=\"650\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 5px 18px rgba(0,0,0,0.08);\">\n\n<tr>\n<td style=\"background:#f59e0b;padding:30px;text-align:center;color:white;\">\n<h1 style=\"margin:0;\">AI Recruitment System</h1>\n<p style=\"margin-top:10px;\">Application Status Update</p>\n</td>\n</tr>\n\n<tr>\n<td style=\"padding:35px;\">\n\n<h2 style=\"color:#d97706;margin-top:0;\">\nHello {{ $json[\"Candidate Name\"] }},\n</h2>\n\n<p style=\"font-size:16px;color:#444;line-height:1.8;\">\nThank you for applying to our company. Your resume has been successfully analyzed by our <strong>AI Recruitment System</strong>.\n</p>\n\n<div style=\"background:#fff8e6;border-left:6px solid #f59e0b;padding:18px;border-radius:6px;margin:25px 0;\">\n\n<h3 style=\"margin-top:0;color:#b45309;\">\nApplication Under Review\n</h3>\n\n<p style=\"margin-bottom:0;color:#444;line-height:1.8;\">\nYour application has passed the initial screening stage and is currently under review by our hiring team. Additional evaluation may be required before a final decision is made.\n</p>\n\n</div>\n\n<h3 style=\"color:#1f2937;border-bottom:2px solid #e5e7eb;padding-bottom:10px;\">\nResume Evaluation Summary\n</h3>\n\n<table width=\"100%\" cellpadding=\"12\" cellspacing=\"0\" style=\"border-collapse:collapse;font-size:15px;\">\n\n<tr style=\"background:#f9fafb;\">\n<td><strong>Candidate Score</strong></td>\n<td>{{ $json[\"Candidate Score\"] }}/100</td>\n</tr>\n\n<tr>\n<td><strong>Experience Score</strong></td>\n<td>{{ $json[\"Experience Score\"] }}/100</td>\n</tr>\n\n<tr style=\"background:#f9fafb;\">\n<td><strong>Skills Score</strong></td>\n<td>{{ $json[\"Skills Score\"] }}/100</td>\n</tr>\n\n<tr>\n<td><strong>Education Score</strong></td>\n<td>{{ $json[\"Education Score\"] }}/100</td>\n</tr>\n\n<tr style=\"background:#f9fafb;\">\n<td><strong>Communication Score</strong></td>\n<td>{{ $json[\"Communication Score\"] }}/100</td>\n</tr>\n\n<tr>\n<td><strong>Recommendation</strong></td>\n<td style=\"font-weight:bold;color:#d97706;\">\n{{ $json[\"Recommendation\"] }}\n</td>\n</tr>\n\n<tr style=\"background:#f9fafb;\">\n<td><strong>AI Assessment</strong></td>\n<td>{{ $json[\"Reason\"] }}</td>\n</tr>\n\n</table>\n\n<div style=\"margin-top:35px;padding:20px;background:#eef6ff;border-left:5px solid #3b82f6;border-radius:6px;\">\n\n<h3 style=\"margin-top:0;color:#1d4ed8;\">\nWhat Happens Next?\n</h3>\n\n<p style=\"color:#444;line-height:1.8;margin-bottom:0;\">\nOur HR team will carefully review your application. If additional information or clarification is required, we will contact you via email. A final hiring decision will be shared after the review is completed.\n</p>\n\n</div>\n\n<p style=\"margin-top:35px;color:#555;line-height:1.8;\">\nWe appreciate the time and effort you invested in your application and thank you for considering our organization as your next career opportunity.\n</p>\n\n<p style=\"margin-top:35px;\">\nKind Regards,<br>\n<strong>AI Recruitment Team</strong>\n</p>\n\n</td>\n</tr>\n\n<tr>\n<td style=\"background:#1f2937;color:white;text-align:center;padding:18px;font-size:13px;\">\n© 2026 AI Recruitment System | Automated Candidate Screening\n</td>\n</tr>\n\n</table>\n\n</td>\n</tr>\n</table>\n\n</body>\n</html>",
